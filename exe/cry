#!/usr/bin/env ruby
# frozen_string_literal: true

# Pry wrapper that auto loads all the things.
#
# @author Ryan Oboril
#

# Make our `lib` path visible to the LOAD_PATH
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

begin
  require 'cry_bug' # do all of the magic
rescue LoadError => e
  warn "Error loading cry_bug dependencies: #{e.message}"
  exit 1
end

Pry.start
